{
  "$defs": {
    "ConditionBucket": {
      "additionalProperties": false,
      "properties": {
        "p25": {
          "title": "P25",
          "type": "number"
        },
        "median": {
          "title": "Median",
          "type": "number"
        },
        "p75": {
          "title": "P75",
          "type": "number"
        },
        "avg_days": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Avg Days"
        },
        "n": {
          "default": 0,
          "title": "N",
          "type": "integer"
        }
      },
      "required": [
        "p25",
        "median",
        "p75"
      ],
      "title": "ConditionBucket",
      "type": "object"
    },
    "ConditionTier": {
      "enum": [
        "fair",
        "good",
        "very_good",
        "mint"
      ],
      "title": "ConditionTier",
      "type": "string"
    },
    "CurvePoint": {
      "additionalProperties": false,
      "description": "Pooled across platforms (theta = 0) unless read from `platforms`.",
      "properties": {
        "price_gbp": {
          "description": "List price",
          "title": "Price Gbp",
          "type": "number"
        },
        "prob_sell_24h": {
          "maximum": 1,
          "minimum": 0,
          "title": "Prob Sell 24H",
          "type": "number"
        },
        "prob_sell_7d": {
          "maximum": 1,
          "minimum": 0,
          "title": "Prob Sell 7D",
          "type": "number"
        },
        "prob_sell_30d": {
          "maximum": 1,
          "minimum": 0,
          "title": "Prob Sell 30D",
          "type": "number"
        },
        "expected_days_to_sell": {
          "maximum": 365.0,
          "minimum": 0,
          "title": "Expected Days To Sell",
          "type": "number"
        },
        "median_days_to_sell": {
          "maximum": 365.0,
          "minimum": 0,
          "title": "Median Days To Sell",
          "type": "number"
        },
        "ci_days_low": {
          "description": "5th percentile of one item's time-to-sell",
          "maximum": 365.0,
          "minimum": 0,
          "title": "Ci Days Low",
          "type": "number"
        },
        "ci_days_high": {
          "description": "95th percentile of one item's time-to-sell",
          "maximum": 365.0,
          "minimum": 0,
          "title": "Ci Days High",
          "type": "number"
        },
        "platforms": {
          "additionalProperties": {
            "$ref": "#/$defs/PlatformPoint"
          },
          "propertyNames": {
            "$ref": "#/$defs/Platform"
          },
          "title": "Platforms",
          "type": "object"
        },
        "best_platform": {
          "$ref": "#/$defs/Platform",
          "description": "Highest net payout x E[exp(-gamma T)]"
        }
      },
      "required": [
        "price_gbp",
        "prob_sell_24h",
        "prob_sell_7d",
        "prob_sell_30d",
        "expected_days_to_sell",
        "median_days_to_sell",
        "ci_days_low",
        "ci_days_high",
        "platforms",
        "best_platform"
      ],
      "title": "CurvePoint",
      "type": "object"
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "title": "Error",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "IdentifyResponse": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.1",
          "title": "Schema Version",
          "type": "string"
        },
        "item": {
          "$ref": "#/$defs/ItemSpec"
        },
        "source": {
          "enum": [
            "vision",
            "text"
          ],
          "title": "Source",
          "type": "string"
        },
        "cleaned_image_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cleaned Image Url"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "item",
        "source"
      ],
      "title": "IdentifyResponse",
      "type": "object"
    },
    "IdentifyTextRequest": {
      "additionalProperties": false,
      "description": "JSON body for the text-search fallback (photos go as multipart/form-data instead).",
      "properties": {
        "query": {
          "minLength": 2,
          "title": "Query",
          "type": "string"
        },
        "condition_tier": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionTier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "query"
      ],
      "title": "IdentifyTextRequest",
      "type": "object"
    },
    "ItemSpec": {
      "additionalProperties": false,
      "description": "Output of /identify and input to /market-scan. Every field is user-editable in the UI.",
      "properties": {
        "title": {
          "description": "Human display title, e.g. \"Nike Air Force 1 '07 Low White\"",
          "title": "Title",
          "type": "string"
        },
        "brand": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Brand"
        },
        "model_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Name"
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "size_or_storage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Or Storage"
        },
        "era_or_year": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Era Or Year"
        },
        "condition_tier": {
          "$ref": "#/$defs/ConditionTier"
        },
        "condition_score": {
          "description": "Vision score 0-10",
          "maximum": 10,
          "minimum": 0,
          "title": "Condition Score",
          "type": "number"
        },
        "detected_flaws": {
          "items": {
            "type": "string"
          },
          "title": "Detected Flaws",
          "type": "array"
        },
        "search_queries": {
          "$ref": "#/$defs/SearchQueries"
        },
        "is_broken": {
          "default": false,
          "description": "If true, the outlier filter keeps 'spares/repairs' listings",
          "title": "Is Broken",
          "type": "boolean"
        },
        "must_have": {
          "description": "Words a matching listing title must contain (\"a|b\" = either), e.g. [\"jordan\", \"low\"]",
          "items": {
            "type": "string"
          },
          "title": "Must Have",
          "type": "array"
        },
        "must_not_have": {
          "description": "Words that mean a different item (other colourways, collabs, replicas), e.g. [\"white\", \"travis\"]",
          "items": {
            "type": "string"
          },
          "title": "Must Not Have",
          "type": "array"
        }
      },
      "required": [
        "title",
        "condition_tier",
        "condition_score",
        "search_queries"
      ],
      "title": "ItemSpec",
      "type": "object"
    },
    "ListingRow": {
      "additionalProperties": false,
      "description": "One normalised marketplace listing. Scrapers emit these; the engine consumes them;\nthe evidence scatter draws them.",
      "properties": {
        "listing_id": {
          "title": "Listing Id",
          "type": "string"
        },
        "platform": {
          "$ref": "#/$defs/Platform"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "price_gbp": {
          "description": "Price shown on the listing (sold price for sold rows)",
          "exclusiveMinimum": 0,
          "title": "Price Gbp",
          "type": "number"
        },
        "shipping_gbp": {
          "default": 0.0,
          "minimum": 0,
          "title": "Shipping Gbp",
          "type": "number"
        },
        "buyer_fee_gbp": {
          "default": 0.0,
          "minimum": 0,
          "title": "Buyer Fee Gbp",
          "type": "number"
        },
        "total_buyer_price_gbp": {
          "exclusiveMinimum": 0,
          "title": "Total Buyer Price Gbp",
          "type": "number"
        },
        "condition_tier": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionTier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "condition_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Platform's own condition text",
          "title": "Condition Raw"
        },
        "obs_type": {
          "$ref": "#/$defs/ObsType"
        },
        "t_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Duration (sold_exact), age (active) or lower bound (sold_interval)",
          "title": "T Days"
        },
        "t_upper_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Upper bound, sold_interval only",
          "title": "T Upper Days"
        },
        "t_entry_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Age when we first saw it (left truncation); None/0 = seen from the start. The likelihood conditions on surviving to this age",
          "title": "T Entry Days"
        },
        "stock_window_days": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Active rows from a newest-first catalogue read back to this age (days): the model uses the age spread of what's still listed (stock sampling)",
          "title": "Stock Window Days"
        },
        "related": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set when this is a similar but different item (e.g. 'mid' for a Jordan 1 Mid when we searched Low): used for selling speed with its price rescaled, never for the price level",
          "title": "Related"
        },
        "start_source": {
          "default": "unknown",
          "description": "How we know when it was listed",
          "enum": [
            "exact",
            "id_calibration",
            "upload_text",
            "unknown"
          ],
          "title": "Start Source",
          "type": "string"
        },
        "listed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Listed At"
        },
        "sold_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sold At"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "favourite_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Favourite Count"
        },
        "best_offer_accepted": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "eBay: true means the real sale price was below price_gbp",
          "title": "Best Offer Accepted"
        },
        "is_outlier": {
          "default": false,
          "title": "Is Outlier",
          "type": "boolean"
        },
        "outlier_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outlier Reason"
        }
      },
      "required": [
        "listing_id",
        "platform",
        "title",
        "price_gbp",
        "total_buyer_price_gbp",
        "obs_type",
        "observed_at"
      ],
      "title": "ListingRow",
      "type": "object"
    },
    "MarkdownStep": {
      "additionalProperties": false,
      "properties": {
        "day": {
          "minimum": 0,
          "title": "Day",
          "type": "integer"
        },
        "list_price_gbp": {
          "title": "List Price Gbp",
          "type": "number"
        },
        "platform": {
          "$ref": "#/$defs/Platform"
        },
        "action": {
          "title": "Action",
          "type": "string"
        }
      },
      "required": [
        "day",
        "list_price_gbp",
        "platform",
        "action"
      ],
      "title": "MarkdownStep",
      "type": "object"
    },
    "MarketScanRequest": {
      "additionalProperties": false,
      "properties": {
        "item": {
          "$ref": "#/$defs/ItemSpec"
        },
        "platforms": {
          "items": {
            "$ref": "#/$defs/Platform"
          },
          "title": "Platforms",
          "type": "array"
        },
        "allow_live": {
          "default": true,
          "description": "False = cache/seed only",
          "title": "Allow Live",
          "type": "boolean"
        }
      },
      "required": [
        "item"
      ],
      "title": "MarketScanRequest",
      "type": "object"
    },
    "MarketScanResponse": {
      "additionalProperties": false,
      "description": "Everything the frontend needs, in one payload; charts are drawn from it with no refetch.",
      "properties": {
        "schema_version": {
          "default": "1.1",
          "title": "Schema Version",
          "type": "string"
        },
        "item_metadata": {
          "$ref": "#/$defs/ItemSpec"
        },
        "cleaned_image_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cleaned Image Url"
        },
        "market_summary": {
          "$ref": "#/$defs/MarketSummary"
        },
        "model_fit": {
          "$ref": "#/$defs/ModelFit"
        },
        "price_range": {
          "$ref": "#/$defs/PriceRange"
        },
        "price_curve_grid": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/CurvePoint"
            },
            "type": "array"
          },
          "description": "GRID_POINTS points per tier, all tiers share the same price axis",
          "propertyNames": {
            "$ref": "#/$defs/ConditionTier"
          },
          "title": "Price Curve Grid",
          "type": "object"
        },
        "sale_surface": {
          "additionalProperties": {
            "$ref": "#/$defs/SaleSurface"
          },
          "propertyNames": {
            "$ref": "#/$defs/ConditionTier"
          },
          "title": "Sale Surface",
          "type": "object"
        },
        "price_markers": {
          "additionalProperties": {
            "$ref": "#/$defs/PriceMarkers"
          },
          "propertyNames": {
            "$ref": "#/$defs/ConditionTier"
          },
          "title": "Price Markers",
          "type": "object"
        },
        "best_platform": {
          "$ref": "#/$defs/Platform",
          "description": "Platform recommended for the item's condition"
        },
        "platform_recommendations": {
          "additionalProperties": {
            "$ref": "#/$defs/PlatformRecommendation"
          },
          "description": "For the item's condition tier",
          "propertyNames": {
            "$ref": "#/$defs/Platform"
          },
          "title": "Platform Recommendations",
          "type": "object"
        },
        "markdown_schedule": {
          "items": {
            "$ref": "#/$defs/MarkdownStep"
          },
          "title": "Markdown Schedule",
          "type": "array"
        },
        "comparable_listings": {
          "description": "Cleaned listings for the evidence scatter",
          "items": {
            "$ref": "#/$defs/ListingRow"
          },
          "maxItems": 500,
          "title": "Comparable Listings",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "item_metadata",
        "market_summary",
        "model_fit",
        "price_range",
        "price_curve_grid",
        "sale_surface",
        "price_markers",
        "best_platform",
        "platform_recommendations",
        "markdown_schedule"
      ],
      "title": "MarketScanResponse",
      "type": "object"
    },
    "MarketSummary": {
      "additionalProperties": false,
      "properties": {
        "sample_size_sold": {
          "title": "Sample Size Sold",
          "type": "integer"
        },
        "sample_size_active": {
          "title": "Sample Size Active",
          "type": "integer"
        },
        "sample_size_excluded": {
          "default": 0,
          "title": "Sample Size Excluded",
          "type": "integer"
        },
        "active_median_gbp": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Median Gbp"
        },
        "sold_median_gbp": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sold Median Gbp"
        },
        "survivorship_bias_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "(active_median - sold_median) / sold_median * 100",
          "title": "Survivorship Bias Pct"
        },
        "condition_buckets": {
          "additionalProperties": {
            "$ref": "#/$defs/ConditionBucket"
          },
          "propertyNames": {
            "$ref": "#/$defs/ConditionTier"
          },
          "title": "Condition Buckets",
          "type": "object"
        },
        "data_source": {
          "enum": [
            "live",
            "db_cache",
            "seed",
            "mock"
          ],
          "title": "Data Source",
          "type": "string"
        },
        "platforms_ok": {
          "items": {
            "$ref": "#/$defs/Platform"
          },
          "title": "Platforms Ok",
          "type": "array"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        }
      },
      "required": [
        "sample_size_sold",
        "sample_size_active",
        "condition_buckets",
        "data_source",
        "platforms_ok",
        "fetched_at"
      ],
      "title": "MarketSummary",
      "type": "object"
    },
    "ModelFit": {
      "additionalProperties": false,
      "description": "Fitted Weibull AFT parameters (maths doc, sections 4-6), for the 'how it works' drawer.",
      "properties": {
        "k": {
          "exclusiveMinimum": 0,
          "title": "K",
          "type": "number"
        },
        "lambda0": {
          "description": "Days, Good condition, typical price, average platform",
          "exclusiveMinimum": 0,
          "title": "Lambda0",
          "type": "number"
        },
        "beta1": {
          "description": "Price effect per spread of markup",
          "title": "Beta1",
          "type": "number"
        },
        "beta2": {
          "description": "Condition effect",
          "title": "Beta2",
          "type": "number"
        },
        "sigma_p": {
          "exclusiveMinimum": 0,
          "title": "Sigma P",
          "type": "number"
        },
        "anchor_gbp": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "M(c), median sold price per condition",
          "propertyNames": {
            "$ref": "#/$defs/ConditionTier"
          },
          "title": "Anchor Gbp",
          "type": "object"
        },
        "platform_theta": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Speed term; lambda multiplied by exp(theta)",
          "propertyNames": {
            "$ref": "#/$defs/Platform"
          },
          "title": "Platform Theta",
          "type": "object"
        },
        "platform_n_sales": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "Observed sales (exact + interval) per platform",
          "propertyNames": {
            "$ref": "#/$defs/Platform"
          },
          "title": "Platform N Sales",
          "type": "object"
        },
        "n_obs": {
          "title": "N Obs",
          "type": "integer"
        },
        "n_censored": {
          "title": "N Censored",
          "type": "integer"
        },
        "n_interval": {
          "default": 0,
          "title": "N Interval",
          "type": "integer"
        },
        "used_priors": {
          "description": "True when thin data left the fit close to the priors",
          "title": "Used Priors",
          "type": "boolean"
        },
        "log_likelihood": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Log Likelihood"
        }
      },
      "required": [
        "k",
        "lambda0",
        "beta1",
        "beta2",
        "sigma_p",
        "anchor_gbp",
        "platform_theta",
        "platform_n_sales",
        "n_obs",
        "n_censored",
        "used_priors"
      ],
      "title": "ModelFit",
      "type": "object"
    },
    "ObsType": {
      "description": "How a listing enters the survival likelihood (maths doc, section 5).\n\nsold_exact        sold, time-to-sale known                  -> ln f(t)\nactive            still unsold after t days                 -> ln S(t)\nsold_interval     sold somewhere in (t, t_upper] days       -> ln[S(t) - S(t_upper)]\n                  e.g. eBay sold item whose start date came from item-number\n                  calibration (sold date is day-only), or a Vinted item seen sold\n                  with t = 0 and t_upper = its age when we checked\nsold_unknown_time sold, no duration at all                  -> price anchors M(c) only",
