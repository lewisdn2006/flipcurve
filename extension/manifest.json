{
  "manifest_version": 3,
  "name": "FlipCurve helper",
  "version": "0.1.0",
  "description": "Looks up eBay and Vinted listings in your own browser when you press Scan on FlipCurve (lewisdn.com/flipcurve).",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://www.ebay.co.uk/*",
    "https://www.vinted.co.uk/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://lewisdn.com/*",
      "https://*.lewisdn.com/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "action": {
    "default_title": "FlipCurve helper"
  },
  "permissions": [
    "storage"
  ]
}
