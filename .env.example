# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Model id is configurable so we can swap if a newer Flash model is faster on the day.
GEMINI_MODEL=gemini-3.8-flash
# Optional: only used if Vinted/eBay block the venue IP.
SERPAPI_KEY=
# 1 = never hit live marketplaces, serve DB cache / cache_seed only (use for the live demo if Wi-Fi is bad).
FLIPCURVE_OFFLINE=0
# How to fetch eBay/Vinted: curl_cffi (default), browser (Playwright) or httpx. See scripts/fetch_diag.py
FLIPCURVE_FETCHER=
FLIPCURVE_IMPERSONATE=chrome
