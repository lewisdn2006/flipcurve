# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Model id is configurable so we can swap if a newer Flash model is faster on the day.
GEMINI_MODEL=gemini-3.8-flash
# Optional: models to try when that one is overloaded (default: the newest other Flash models your key can use)
# GEMINI_FALLBACK_MODELS=
# Optional: Claude as a backup when Gemini is busy (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=
# Photo identify asks Gemini first. gemma = ask Gemma first (much bigger free allowance, a bit less
# accurate); claude = ask Claude first (needs ANTHROPIC_API_KEY)
# PHOTO_AI_FIRST=gemini
# Gemma is found automatically and tried after the Flash models; set an exact id to pin it, or empty to turn it off
# GEMMA_MODEL=gemma-4-31b-it
# CLAUDE_MODEL=claude-haiku-5-5
# Optional: only used if Vinted/eBay block the venue IP.
SERPAPI_KEY=
# 1 = never hit live marketplaces, serve DB cache / cache_seed only (use for the live demo if Wi-Fi is bad).
FLIPCURVE_OFFLINE=0
# How to fetch eBay/Vinted pages: browser (default, real Chromium via Playwright) or httpx
FLIPCURVE_FETCHER=browser
# 0 = show the browser window while it fetches (handy for a demo)
FLIPCURVE_HEADLESS=1
# Optional: official eBay Browse API keys (developer.ebay.com > Application Keys, Production)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
