// FlipCurve API Worker (NO_LAPTOP_PLAN.md). Deploy from this folder: npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flipcurve-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // api.lewisdn.com is the address the page and the helper extension use (switched from the laptop
  // tunnel on 26 Oct 2026). A route, so the tunnel's DNS record could stay: to go back to the
  // laptop, remove this and deploy. Also at https://flipcurve-api.lewisdn2006.workers.dev
  "routes": [{ "pattern": "api.lewisdn.com/*", "zone_name": "lewisdn.com" }],
  "workers_dev": true,
  // Builds the browser engine (dist/core-text.js) and the example payload before every deploy
  "build": { "command": "npm run build", "watch_dir": "src" },
  // No "limits": the page does the heavy work in the browser, so this fits the free plan (10 ms of CPU
  // per request). On the free plan /api/v1/scan-pages and /market-scan would run out of CPU; the
  // page doesn't use them any more.
  "observability": { "enabled": true },
  // Same meaning as in the laptop's .env (backend/vision/gemini_identifier.py)
  "vars": { "GEMINI_MODEL": "gemini-3.8-flash", "PHOTO_AI_FIRST": "gemma" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flipcurve-db",
      "database_id": "3e57acd2-4a6c-4ef2-b8f3-a9826d37632c",
      "migrations_dir": "migrations"
    }
  ]
  // Secrets (npx wrangler secret put NAME): GEMINI_API_KEY, EBAY_CLIENT_ID, EBAY_CLIENT_SECRET,
  // and optionally ANTHROPIC_API_KEY (Claude as a backup for identify)
}
